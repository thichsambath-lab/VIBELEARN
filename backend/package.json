{
  "name": "backend",
  "version": "1.0.0",
  "description": "Vibelearn Backend API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "@clerk/express": "^2.1.67",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1"
  }
}
